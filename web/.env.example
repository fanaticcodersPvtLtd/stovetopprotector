# Astro frontend — copy to web/.env and fill in
PAYLOAD_API_URL=http://localhost:3001/api          # Payload REST base (build-time SSG fetches)
PUBLIC_PAYLOAD_API_URL=http://localhost:3001/api   # same, but exposed to client JS for visitor auth
SITE_URL=http://localhost:4321                     # Public site URL; prod: https://stoveguard.us.com
GA4_MEASUREMENT_ID=                                # GA4 stream ID (G-XXXXXXXXXX). Empty = no analytics rendered.
