---
import { getApprovedReviewsFor, reviewAuthorName } from '../lib/payload'

interface Props {
  /** The polymorphic target collection slug, e.g. "comparison-articles". */
  targetType: string
  /** The target document id. */
  targetId: number
}

const { targetType, targetId } = Astro.props
const reviews = await getApprovedReviewsFor(targetType, targetId)

const avgRating =
  reviews.length > 0
    ? reviews.reduce((sum, r) => sum + r.rating, 0) / reviews.length
    : 0

function fmtDate(iso?: string): string {
  if (!iso) return ''
  return new Date(iso).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  })
}
---

<section id="reviews" class="border-t border-border-faint py-10">
  <div class="mb-6 flex items-end justify-between">
    <h2 class="m-0 font-headline text-2xl font-bold text-ink">Reader Reviews</h2>
    {
      reviews.length > 0 && (
        <span class="flex items-center gap-1.5 text-sm font-bold text-ink">
          <span
            class="material-symbols-outlined text-base text-primary"
            style="font-variation-settings: 'FILL' 1;"
          >
            star
          </span>
          {avgRating.toFixed(1)} · {reviews.length}{' '}
          {reviews.length === 1 ? 'review' : 'reviews'}
        </span>
      )
    }
  </div>

  {
    reviews.length === 0 ? (
      <p class="mb-6 text-sm text-muted">
        No reader reviews yet. Be the first to share your experience.
      </p>
    ) : (
      <ul class="mb-8 space-y-4">
        {reviews.map((review) => (
          <li class="rounded-lg border border-border-subtle bg-white p-5">
            <div class="mb-2 flex items-center justify-between">
              <span class="font-bold text-ink">{reviewAuthorName(review)}</span>
              <span class="flex items-center gap-1 text-sm font-bold text-primary">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span
                    class="material-symbols-outlined text-sm"
                    style={
                      i < review.rating ? "font-variation-settings: 'FILL' 1;" : ''
                    }
                  >
                    star
                  </span>
                ))}
              </span>
            </div>
            <p class="m-0 mb-2 text-sm leading-relaxed text-ink-soft">{review.body}</p>
            {review.submittedAt && (
              <span class="text-[11px] text-muted-soft">{fmtDate(review.submittedAt)}</span>
            )}
          </li>
        ))}
      </ul>
    )
  }

  {/* Submission form — populated client-side by reviewForm.ts (auth-gated). */}
  <div data-review-form-root data-target-type={targetType} data-target-id={targetId}>
    <div class="rounded-lg border border-border-subtle bg-surface-container p-6 text-center">
      <p class="text-sm text-muted">Loading…</p>
    </div>
  </div>
</section>

<script>
  import '../scripts/reviewForm.ts'
</script>
