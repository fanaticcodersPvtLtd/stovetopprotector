---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getPublishedReviewArticles } from '../../lib/payload'

const reviews = await getPublishedReviewArticles()
---

<BaseLayout
  title="Stove Protector Brand Reviews — StoveGuard Reviews"
  description="Independent, in-depth reviews of stove top protector brands. No affiliations, no affiliate links."
  activeNav="reviews"
>
  <main class="mx-auto max-w-[1160px] px-6 pb-20 pt-28 md:px-8">
    <h1 class="mb-2 font-headline text-4xl font-bold leading-[1.1] text-ink md:text-5xl">
      Brand Reviews
    </h1>
    <p class="mb-12 max-w-2xl text-lg text-muted">
      In-depth, independent deep-dives on individual stove top protector
      brands — product lineups, real customer sentiment, and our honest verdict.
    </p>

    {
      reviews.length === 0 ? (
        <div class="rounded-lg border border-border-subtle bg-surface-card p-10 text-center">
          <p class="font-headline text-lg text-muted">
            No brand reviews published yet. Check back soon.
          </p>
        </div>
      ) : (
        <ul class="grid gap-6 md:grid-cols-2">
          {reviews.map((review) => (
            <li>
              <a
                href={`/reviews/${review.slug}`}
                class="group flex h-full flex-col rounded-lg border border-border-subtle bg-surface-card p-6 transition-colors hover:border-primary"
              >
                <div class="mb-3 flex items-center justify-between">
                  <span class="text-[11px] font-extrabold uppercase tracking-widest text-primary">
                    {review.brand}
                  </span>
                  <span class="flex items-center gap-1 text-sm font-bold text-ink">
                    <span
                      class="material-symbols-outlined text-base text-primary"
                      style="font-variation-settings: 'FILL' 1;"
                    >
                      star
                    </span>
                    {review.ratingOutOf5.toFixed(1)}
                  </span>
                </div>
                <h2 class="mb-2 font-headline text-xl font-bold leading-snug text-ink group-hover:text-primary">
                  {review.title}
                </h2>
                <p class="text-sm text-muted">{review.metaDescription}</p>
                {review.readTimeMinutes && (
                  <span class="mt-3 text-[11px] text-muted-soft">
                    {review.readTimeMinutes} min read
                  </span>
                )}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </main>
</BaseLayout>
