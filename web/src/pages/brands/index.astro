---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getPublishedBrandPages } from '../../lib/payload'

const brands = await getPublishedBrandPages()
---

<BaseLayout
  title="Stove Protectors by Appliance Brand — StoveGuard Reviews"
  description="Find the right stove top protector for your GE, Samsung, Frigidaire, or other brand stove."
  activeNav="brands"
>
  <main class="mx-auto max-w-[1160px] px-6 pb-20 pt-28 md:px-8">
    <h1 class="mb-2 font-headline text-4xl font-bold leading-[1.1] text-ink md:text-5xl">
      By Appliance Brand
    </h1>
    <p class="mb-12 max-w-2xl text-lg text-muted">
      Stove protectors that fit your specific appliance — model lists,
      compatibility notes, and install tips for each major brand.
    </p>

    {
      brands.length === 0 ? (
        <div class="rounded-lg border border-border-subtle bg-surface-card p-10 text-center">
          <p class="font-headline text-lg text-muted">
            No brand pages published yet. Check back soon.
          </p>
        </div>
      ) : (
        <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {brands.map((brand) => (
            <li>
              <a
                href={`/brands/${brand.slug}`}
                class="group flex h-full flex-col rounded-lg border border-border-subtle bg-surface-card p-6 transition-colors hover:border-primary"
              >
                <span class="mb-2 inline-flex items-center gap-1.5 text-[11px] font-extrabold uppercase tracking-widest text-primary">
                  <span class="material-symbols-outlined text-sm">kitchen</span>
                  Brand Guide
                </span>
                <h2 class="mb-1 font-headline text-xl font-bold text-ink group-hover:text-primary">
                  {brand.brandName}
                </h2>
                <p class="text-sm text-muted">{brand.metaDescription}</p>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </main>
</BaseLayout>
