---
import BaseLayout from '../../layouts/BaseLayout.astro'
import NewsletterSignup from '../../components/NewsletterSignup.astro'
---

<BaseLayout
  title="Newsletter — StoveGuard Reviews"
  description="Get new stove top protector comparisons, reviews, and buying guides in your inbox."
>
  <main class="mx-auto max-w-2xl px-6 pt-28 pb-20">
    <div
      class="mb-6 inline-flex items-center gap-2 rounded-full border border-orange-100 bg-orange-50 px-3 py-1 text-xs font-bold uppercase tracking-widest text-primary-bright"
    >
      <span class="material-symbols-outlined text-sm">mail</span>
      Newsletter
    </div>
    <h1 class="mb-3 font-headline text-4xl font-bold leading-[1.1] text-ink md:text-5xl">
      New comparisons, straight to your inbox.
    </h1>
    <p class="mb-8 text-lg text-muted">
      We'll send you new brand comparisons, reviews, and buying guides as we
      publish them. No spam, no affiliate pitches — just the research. Confirm
      via a double opt-in email, unsubscribe any time.
    </p>

    <NewsletterSignup variant="panel" />

    <ul class="mt-10 space-y-3 text-sm text-muted">
      <li class="flex items-start gap-2">
        <span class="material-symbols-outlined text-base text-primary">check_circle</span>
        Independent testing — no brand affiliations, no commissions
      </li>
      <li class="flex items-start gap-2">
        <span class="material-symbols-outlined text-base text-primary">check_circle</span>
        Only when there's something new worth reading
      </li>
      <li class="flex items-start gap-2">
        <span class="material-symbols-outlined text-base text-primary">check_circle</span>
        One-click unsubscribe in every email
      </li>
    </ul>
  </main>
</BaseLayout>
