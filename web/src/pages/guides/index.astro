---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getPublishedEducationalGuides } from '../../lib/payload'

const guides = await getPublishedEducationalGuides()
---

<BaseLayout
  title="Stove Protector Guides — StoveGuard Reviews"
  description="Educational guides on stove top protectors — thickness, materials, safety, and how to choose."
  activeNav="guides"
>
  <main class="mx-auto max-w-[1160px] px-6 pb-20 pt-28 md:px-8">
    <h1 class="mb-2 font-headline text-4xl font-bold leading-[1.1] text-ink md:text-5xl">
      Educational Guides
    </h1>
    <p class="mb-12 max-w-2xl text-lg text-muted">
      Everything you need to understand stove top protectors — materials,
      thickness, heat resistance, safety, and how to pick the right one.
    </p>

    {
      guides.length === 0 ? (
        <div class="rounded-lg border border-border-subtle bg-surface-card p-10 text-center">
          <p class="font-headline text-lg text-muted">
            No guides published yet. Check back soon.
          </p>
        </div>
      ) : (
        <ul class="grid gap-6 md:grid-cols-2">
          {guides.map((guide) => (
            <li>
              <a
                href={`/guides/${guide.slug}`}
                class="group flex h-full flex-col rounded-lg border border-border-subtle bg-surface-card p-6 transition-colors hover:border-primary"
              >
                <span class="mb-3 inline-flex items-center gap-1.5 text-[11px] font-extrabold uppercase tracking-widest text-primary">
                  <span class="material-symbols-outlined text-sm">menu_book</span>
                  Guide
                </span>
                <h2 class="mb-2 font-headline text-xl font-bold leading-snug text-ink group-hover:text-primary">
                  {guide.title}
                </h2>
                <p class="text-sm text-muted">{guide.metaDescription}</p>
                {guide.readTimeMinutes && (
                  <span class="mt-3 text-[11px] text-muted-soft">
                    {guide.readTimeMinutes} min read
                  </span>
                )}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </main>
</BaseLayout>
