---
import BaseLayout from '../../layouts/BaseLayout.astro'
import {
  getPublishedBuyerGuides,
  getBuyerGuideBySlug,
  formatUsd,
} from '../../lib/payload'
import { lexicalToHtml } from '../../lib/lexical'
import { buyerGuideLd } from '../../lib/seo'

export async function getStaticPaths() {
  const guides = await getPublishedBuyerGuides()
  return guides.map((guide) => ({ params: { slug: guide.slug } }))
}

const { slug } = Astro.params
const guide = await getBuyerGuideBySlug(slug!)

// getStaticPaths only emits published slugs — safety net, not an expected branch.
// rewrite (not redirect) so the 404 renders correctly in a static build.
if (!guide) {
  return Astro.rewrite('/404')
}

const bodyHtml = lexicalToHtml(guide.body)
const publishedDate = guide.publishedAt
  ? new Date(guide.publishedAt).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    })
  : null

// Sort ranked entries by rank ascending — never trust array order from the API.
const ranked = [...(guide.rankedProducts ?? [])].sort((a, b) => a.rank - b.rank)

const BADGE_LABELS: Record<string, string> = {
  'best-overall': 'Best Overall',
  'best-for-gas': 'Best for Gas',
  'best-for-glass': 'Best for Glass-Top',
  'best-budget': 'Best Budget',
  'best-for-rv': 'Best for RV',
}

const pageUrl = new URL(Astro.url.pathname, Astro.site ?? 'http://localhost:4321').href
const jsonLd = buyerGuideLd(guide, pageUrl)
---

<BaseLayout
  title={guide.title}
  description={guide.metaDescription}
  activeNav="best"
  jsonLd={jsonLd}
>
  <main class="mx-auto max-w-[1160px] px-6 pb-20 pt-28 md:px-8">
    <!-- Breadcrumbs -->
    <nav
      class="mb-4 flex items-center gap-2 text-xs font-medium uppercase tracking-wider text-muted"
    >
      <a href="/" class="hover:text-ink">Home</a>
      <span class="material-symbols-outlined text-[14px]">chevron_right</span>
      <a href="/best" class="hover:text-ink">Best Of</a>
      <span class="material-symbols-outlined text-[14px]">chevron_right</span>
      <span class="text-primary-bright">{guide.title}</span>
    </nav>

    <div
      class="mb-6 inline-flex items-center gap-2 rounded-full border border-orange-100 bg-orange-50 px-3 py-1 text-xs font-bold uppercase tracking-widest text-primary-bright"
    >
      <span class="material-symbols-outlined text-sm">trophy</span>
      Buyer Guide
    </div>

    <h1
      class="mb-8 max-w-4xl font-headline text-4xl font-bold leading-[1.1] text-ink md:text-5xl lg:text-6xl"
    >
      {guide.title}
    </h1>

    <div
      class="mb-10 flex flex-wrap items-center gap-6 border-b border-border-faint pb-8 text-[13px] font-medium text-muted"
    >
      {
        publishedDate && (
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-lg text-primary-bright">schedule</span>
            Updated {publishedDate}
          </div>
        )
      }
      {
        guide.readTimeMinutes && (
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-lg text-primary-bright">menu_book</span>
            {guide.readTimeMinutes} min read
          </div>
        )
      }
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-lg text-primary-bright">verified_user</span>
        Independently Tested
      </div>
    </div>

    <div class="flex flex-col gap-12 lg:flex-row">
      <!-- Main content -->
      <article class="article-body max-w-[760px] flex-1">
        <!-- Methodology box -->
        <section
          class="mb-10 flex items-start gap-4 rounded-lg border border-border-subtle bg-surface-container p-6"
        >
          <span class="material-symbols-outlined mt-0.5 text-primary">science</span>
          <div>
            <h2 id="methodology" class="m-0 mb-2 text-sm font-extrabold uppercase tracking-widest text-primary">
              How We Tested
            </h2>
            <p class="m-0 font-headline text-base leading-relaxed text-ink-soft">
              {guide.methodology}
            </p>
          </div>
        </section>

        <!-- Ranked list -->
        {
          ranked.length > 0 && (
            <>
              <h2 id="rankings">The Rankings</h2>
              <ol class="mb-10 space-y-6 !list-none !ml-0">
                {ranked.map((entry) => (
                  <li class="rounded-lg border border-border-subtle bg-white p-6">
                    <div class="mb-3 flex items-start justify-between gap-4">
                      <div class="flex items-center gap-3">
                        <span
                          class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full bg-primary font-headline text-lg font-bold text-white"
                        >
                          {entry.rank}
                        </span>
                        <div>
                          <h3 class="m-0 font-headline text-xl font-bold text-ink">
                            {entry.product.brand} {entry.product.productName}
                          </h3>
                          {entry.badge && entry.badge !== 'none' && (
                            <span class="mt-1 inline-block rounded-full bg-surface-warm px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-primary-bright">
                              {BADGE_LABELS[entry.badge]}
                            </span>
                          )}
                        </div>
                      </div>
                      <div class="flex flex-shrink-0 flex-col items-end">
                        <span class="font-headline text-2xl font-bold text-primary">
                          {entry.ourScore.toFixed(1)}
                        </span>
                        <span class="text-[10px] uppercase tracking-widest text-muted-soft">
                          our score
                        </span>
                      </div>
                    </div>
                    <p class="m-0 mb-3 text-sm leading-relaxed text-ink-soft">
                      <span class="font-bold text-green-700">What it does well: </span>
                      {entry.positives}
                    </p>
                    <p class="m-0 mb-4 text-sm leading-relaxed text-ink-soft">
                      <span class="font-bold text-muted">Drawbacks: </span>
                      {entry.drawbacks}
                    </p>
                    <div class="flex items-center justify-between border-t border-border-faint pt-3">
                      <span class="font-headline text-lg font-bold text-ink">
                        {formatUsd(entry.product.priceUsd)}
                      </span>
                      <a
                        href={entry.product.productUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1 text-sm font-semibold text-primary hover:underline"
                      >
                        Visit official site
                        <span class="material-symbols-outlined text-base">open_in_new</span>
                      </a>
                    </div>
                  </li>
                ))}
              </ol>
            </>
          )
        }

        <!-- Guide body (rich text) -->
        <div set:html={bodyHtml} />

        <!-- FAQ -->
        {
          guide.faqs && guide.faqs.length > 0 && (
            <>
              <h2 id="faq">Frequently Asked Questions</h2>
              <div class="mb-12 space-y-4">
                {guide.faqs.map((faq) => (
                  <details class="group rounded-lg border border-border-subtle bg-white">
                    <summary
                      class="flex cursor-pointer list-none items-center justify-between p-5 font-bold"
                    >
                      {faq.question}
                      <span
                        class="material-symbols-outlined transition-transform group-open:rotate-180"
                      >
                        expand_more
                      </span>
                    </summary>
                    <div class="p-5 pt-0 font-headline text-base text-ink-soft">
                      {faq.answer}
                    </div>
                  </details>
                ))}
              </div>
            </>
          )
        }

        <!-- CTA -->
        <div class="mb-10 rounded-xl bg-ink-dark p-10 text-center">
          <h2 class="mb-4 mt-0 font-headline text-3xl text-white">
            Want the head-to-head detail?
          </h2>
          <p class="mb-8 font-body text-base text-stone-400">
            Rankings give you the shortlist. Our comparisons break down any two
            brands spec by spec.
          </p>
          <a
            href="/compare"
            class="group inline-flex items-center gap-2 rounded-lg bg-primary-bright px-8 py-4 font-bold text-white transition-all hover:bg-primary-hover"
          >
            See all comparisons
            <span class="material-symbols-outlined transition-transform group-hover:translate-x-1">
              arrow_forward
            </span>
          </a>
        </div>

        <!-- Disclosure -->
        <div
          class="mb-10 rounded-lg border border-border-subtle bg-surface-container p-5 text-[13px] italic text-muted"
        >
          Disclosure: stoveguard.us.com is independent. We have no brand
          affiliations, no affiliate links, and earn no commissions — this site
          is supported by display advertising. Rankings reflect our own testing
          and judgment.
        </div>

        <!-- Sources -->
        {
          guide.sources && guide.sources.length > 0 && (
            <div id="sources" class="mb-10 border-t border-border-faint pt-8">
              <h5 class="mb-6 text-xs font-bold uppercase tracking-widest text-muted">
                Article Sources &amp; Research
              </h5>
              <ol class="space-y-3 text-[13px] text-muted">
                {guide.sources.map((source, i) => (
                  <li>
                    <span class="mr-2 font-bold text-primary">{i + 1}.</span>
                    {source.url ? (
                      <a
                        href={source.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="italic hover:text-primary"
                      >
                        {source.label}
                      </a>
                    ) : (
                      <i>{source.label}</i>
                    )}
                  </li>
                ))}
              </ol>
            </div>
          )
        }
      </article>

      <!-- Sidebar -->
      <aside class="w-full space-y-8 lg:w-[280px]">
        <!-- TOC -->
        <div class="sticky top-24 rounded-lg border border-border-subtle bg-white p-6">
          <h5
            class="mb-4 flex items-center gap-2 text-[11px] font-extrabold uppercase tracking-widest text-muted-soft"
          >
            <span class="material-symbols-outlined text-sm">toc</span> On This Page
          </h5>
          <nav class="flex flex-col gap-1 text-[13px] font-medium text-muted">
            <a class="rounded px-3 py-2 transition-colors hover:bg-surface-warm hover:text-primary" href="#methodology">How We Tested</a>
            {
              ranked.length > 0 && (
                <a class="rounded px-3 py-2 transition-colors hover:bg-surface-warm hover:text-primary" href="#rankings">
                  The Rankings
                </a>
              )
            }
            {
              guide.faqs && guide.faqs.length > 0 && (
                <a class="rounded px-3 py-2 transition-colors hover:bg-surface-warm hover:text-primary" href="#faq">
                  FAQ
                </a>
              )
            }
            {
              guide.sources && guide.sources.length > 0 && (
                <a class="rounded px-3 py-2 transition-colors hover:bg-surface-warm hover:text-primary" href="#sources">
                  Sources
                </a>
              )
            }
          </nav>
        </div>

        <!-- Top pick -->
        {
          ranked.length > 0 && (
            <div class="rounded-lg border border-border-subtle bg-surface-container p-6">
              <h5 class="mb-4 text-[11px] font-extrabold uppercase tracking-widest text-ink">
                Our Top Pick
              </h5>
              <div class="space-y-1">
                <span class="block font-headline text-base font-bold text-ink">
                  {ranked[0].product.brand} {ranked[0].product.productName}
                </span>
                <span class="block text-sm text-muted">
                  {formatUsd(ranked[0].product.priceUsd)} · scored{' '}
                  {ranked[0].ourScore.toFixed(1)}/5
                </span>
              </div>
            </div>
          )
        }

        <!-- Related guides -->
        {
          guide.relatedGuides && guide.relatedGuides.length > 0 && (
            <div class="rounded-lg border border-border-subtle bg-white p-6">
              <h5 class="mb-4 text-[11px] font-extrabold uppercase tracking-widest text-primary">
                Related Guides
              </h5>
              <div class="flex flex-col gap-4">
                {guide.relatedGuides.map((related) => (
                  <a href={`/best/${related.slug}`} class="group">
                    <h6
                      class="text-[14px] font-bold leading-snug transition-colors group-hover:text-primary"
                    >
                      {related.title}
                    </h6>
                    {related.readTimeMinutes && (
                      <span class="text-[11px] text-muted-soft">
                        {related.readTimeMinutes} min read
                      </span>
                    )}
                  </a>
                ))}
              </div>
            </div>
          )
        }
      </aside>
    </div>
  </main>
</BaseLayout>
