---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
  title="Create an Account — StoveGuard Reviews"
  description="Create a StoveGuard Reviews account to submit reviews and comments."
  noindex={true}
>
  <main class="mx-auto flex min-h-[70vh] max-w-md flex-col justify-center px-6 pt-28 pb-20">
    <h1 class="mb-2 font-headline text-3xl font-bold text-ink">Create your account</h1>
    <p class="mb-8 text-sm text-muted">
      Join to submit reviews and comments. No real name required — pick any
      display name.
    </p>

    <form id="register-form" class="space-y-4" novalidate>
      <div>
        <label for="displayName" class="mb-1 block text-[11px] font-extrabold uppercase tracking-widest text-muted-soft">
          Display Name
        </label>
        <input
          id="displayName"
          name="displayName"
          type="text"
          required
          class="w-full rounded-lg border border-border-subtle bg-white px-4 py-3 text-sm text-ink"
        />
      </div>
      <div>
        <label for="email" class="mb-1 block text-[11px] font-extrabold uppercase tracking-widest text-muted-soft">
          Email
        </label>
        <input
          id="email"
          name="email"
          type="email"
          required
          class="w-full rounded-lg border border-border-subtle bg-white px-4 py-3 text-sm text-ink"
        />
      </div>
      <div>
        <label for="password" class="mb-1 block text-[11px] font-extrabold uppercase tracking-widest text-muted-soft">
          Password
        </label>
        <input
          id="password"
          name="password"
          type="password"
          required
          minlength="8"
          class="w-full rounded-lg border border-border-subtle bg-white px-4 py-3 text-sm text-ink"
        />
      </div>

      <p id="form-error" class="hidden rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700"></p>
      <p id="form-success" class="hidden rounded-lg bg-surface-warm px-4 py-3 text-sm text-ink"></p>

      <button
        type="submit"
        id="submit-btn"
        class="w-full rounded-lg bg-primary-bright px-6 py-3 font-bold text-white transition-colors hover:bg-primary-hover disabled:opacity-60"
      >
        Create account
      </button>
    </form>

    <p class="mt-6 text-center text-sm text-muted">
      Already have an account?
      <a href="/login" class="font-semibold text-primary hover:underline">Log in</a>
    </p>
  </main>
</BaseLayout>

<script>
  const API = (import.meta.env.PUBLIC_PAYLOAD_API_URL ||
    'http://localhost:3001/api') as string
  const form = document.getElementById('register-form') as HTMLFormElement | null
  const errEl = document.getElementById('form-error') as HTMLElement | null
  const okEl = document.getElementById('form-success') as HTMLElement | null
  const btn = document.getElementById('submit-btn') as HTMLButtonElement | null

  function showError(msg: string) {
    if (!errEl) return
    errEl.textContent = msg
    errEl.classList.remove('hidden')
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault()
    errEl?.classList.add('hidden')
    okEl?.classList.add('hidden')
    if (btn) btn.disabled = true

    const fd = new FormData(form)
    const payload = {
      displayName: String(fd.get('displayName') ?? ''),
      email: String(fd.get('email') ?? ''),
      password: String(fd.get('password') ?? ''),
    }

    try {
      const res = await fetch(`${API}/users`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      })
      const data = await res.json()
      if (!res.ok) {
        showError(data?.errors?.[0]?.message ?? 'Could not create the account.')
        if (btn) btn.disabled = false
        return
      }
      if (okEl) {
        okEl.textContent =
          'Account created. Check your email for a verification link before logging in.'
        okEl.classList.remove('hidden')
      }
      form.reset()
    } catch {
      showError('Network error — please try again.')
      if (btn) btn.disabled = false
    }
  })
</script>
