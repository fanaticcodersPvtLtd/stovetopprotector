---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
  title="Log In — StoveGuard Reviews"
  description="Log in to your StoveGuard Reviews account."
  noindex={true}
>
  <main class="mx-auto flex min-h-[70vh] max-w-md flex-col justify-center px-6 pt-28 pb-20">
    <h1 class="mb-2 font-headline text-3xl font-bold text-ink">Log in</h1>
    <p class="mb-8 text-sm text-muted">Welcome back. Log in to submit reviews and comments.</p>

    <form id="login-form" class="space-y-4" novalidate>
      <div>
        <label for="email" class="mb-1 block text-[11px] font-extrabold uppercase tracking-widest text-muted-soft">
          Email
        </label>
        <input
          id="email"
          name="email"
          type="email"
          required
          class="w-full rounded-lg border border-border-subtle bg-white px-4 py-3 text-sm text-ink"
        />
      </div>
      <div>
        <label for="password" class="mb-1 block text-[11px] font-extrabold uppercase tracking-widest text-muted-soft">
          Password
        </label>
        <input
          id="password"
          name="password"
          type="password"
          required
          class="w-full rounded-lg border border-border-subtle bg-white px-4 py-3 text-sm text-ink"
        />
      </div>

      <p id="form-error" class="hidden rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700"></p>

      <button
        type="submit"
        id="submit-btn"
        class="w-full rounded-lg bg-primary-bright px-6 py-3 font-bold text-white transition-colors hover:bg-primary-hover disabled:opacity-60"
      >
        Log in
      </button>
    </form>

    <p class="mt-6 text-center text-sm text-muted">
      No account yet?
      <a href="/register" class="font-semibold text-primary hover:underline">Create one</a>
    </p>
  </main>
</BaseLayout>

<script>
  const API = (import.meta.env.PUBLIC_PAYLOAD_API_URL ||
    'http://localhost:3001/api') as string
  const form = document.getElementById('login-form') as HTMLFormElement | null
  const errEl = document.getElementById('form-error') as HTMLElement | null
  const btn = document.getElementById('submit-btn') as HTMLButtonElement | null

  function showError(msg: string) {
    if (!errEl) return
    errEl.textContent = msg
    errEl.classList.remove('hidden')
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault()
    errEl?.classList.add('hidden')
    if (btn) btn.disabled = true

    const fd = new FormData(form)
    try {
      const res = await fetch(`${API}/users/login`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({
          email: String(fd.get('email') ?? ''),
          password: String(fd.get('password') ?? ''),
        }),
      })
      const data = await res.json()
      if (!res.ok) {
        showError(
          data?.errors?.[0]?.message ??
            'Login failed. Check your credentials, or verify your email first.',
        )
        if (btn) btn.disabled = false
        return
      }
      // Payload set the session cookie — go to profile.
      window.location.href = '/profile'
    } catch {
      showError('Network error — please try again.')
      if (btn) btn.disabled = false
    }
  })
</script>
