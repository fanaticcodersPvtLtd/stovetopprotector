---
import '../styles/global.css'

interface Props {
  title: string
  description?: string
  activeNav?: 'home' | 'comparisons' | 'reviews' | 'best' | 'guides' | 'brands'
}

const { title, description, activeNav } = Astro.props

const navLinks = [
  { key: 'home', label: 'Home', href: '/' },
  { key: 'comparisons', label: 'Comparisons', href: '/compare' },
  { key: 'reviews', label: 'Reviews', href: '/reviews' },
  { key: 'best', label: 'Best Of', href: '/best' },
  { key: 'guides', label: 'Guides', href: '/guides' },
  { key: 'brands', label: 'By Brand', href: '/brands' },
] as const
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-background text-ink font-body antialiased">
    <header
      class="fixed top-0 z-50 w-full border-b border-border-faint bg-white/80 backdrop-blur-md"
    >
      <nav class="mx-auto flex h-16 max-w-[1160px] items-center justify-between px-6 md:px-8">
        <a href="/" class="text-sm font-bold tracking-tight text-ink">StoveGuard Reviews</a>
        <div class="hidden gap-1 md:flex">
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                class:list={[
                  'rounded-md px-3 py-1.5 text-[13px] transition-colors',
                  activeNav === link.key
                    ? 'bg-surface-warm font-bold text-primary-bright'
                    : 'font-medium text-muted hover:text-ink',
                ]}
              >
                {link.label}
              </a>
            ))
          }
        </div>
        <span class="material-symbols-outlined cursor-pointer text-muted-soft">search</span>
      </nav>
    </header>

    <slot />

    <footer class="w-full border-t border-[#292524] bg-ink-dark py-12">
      <div
        class="mx-auto flex max-w-[1160px] flex-col items-center space-y-6 px-4 text-center"
      >
        <div class="text-lg font-bold text-white">StoveGuard Reviews</div>
        <div class="flex flex-wrap justify-center gap-6">
          <a href="/privacy" class="text-[11px] text-[#57534e] transition-colors hover:text-stone-300">Privacy</a>
          <a href="/terms" class="text-[11px] text-[#57534e] transition-colors hover:text-stone-300">Terms</a>
          <a href="/contact" class="text-[11px] text-[#57534e] transition-colors hover:text-stone-300">Contact</a>
          <a href="/about" class="text-[11px] text-[#57534e] transition-colors hover:text-stone-300">About</a>
          <a href="/brands" class="text-[11px] text-[#57534e] transition-colors hover:text-stone-300">All Brands</a>
        </div>
        <p class="max-w-2xl text-[11px] leading-relaxed text-[#57534e]">
          This is an independent review site. We have no brand affiliations, no
          affiliate links, and earn no commissions. Not affiliated with any brand
          mentioned. All trademarks belong to their respective owners.
        </p>
      </div>
    </footer>

    <style>
      .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        vertical-align: middle;
      }
    </style>
  </body>
</html>
