# Payload CMS — copy to cms/.env and fill in values
PAYLOAD_SECRET=                                           # min 32 chars, generate via: openssl rand -hex 32
DATABASE_URI=postgresql://stoveguard:stoveguard_dev@localhost:5432/stoveguard
PAYLOAD_SERVER_URL=http://localhost:3001
NODE_ENV=development
PORT=3001

# Cloudflare Pages deploy hook — POSTed by afterChange hooks when content is published.
# Leave UNSET in local dev: triggerDeploy() no-ops cleanly when absent, so local
# CMS writes don't burn Cloudflare build minutes.
# SET this in the production CMS environment (Railway/Render) so publishing rebuilds the site.
CLOUDFLARE_DEPLOY_HOOK_URL=
