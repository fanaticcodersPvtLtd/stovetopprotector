# ==============================================================================
# StoveGuard.us.com — Environment Variables
# Copy to .env and fill in values before running
#
# Auth: Payload CMS built-in (JWT + httpOnly cookies + OAuth plugin)
# Database: Postgres (self-hosted via Railway or Render)
# No Supabase. No external auth service.
# ==============================================================================

# --- Payload CMS Core (Issue #1) ---
PAYLOAD_SECRET=                    # Random string, min 32 chars. Signs JWT tokens for both cms-admins and users.
PAYLOAD_SERVER_URL=                # e.g. http://localhost:3000 (local) or https://cms.stoveguard.us.com
DATABASE_URI=                      # Postgres connection string: postgresql://user:pass@host:5432/dbname

# --- Payload Admin Seed (Issue #1) ---
PAYLOAD_ADMIN_EMAIL=               # First super-admin account email (seeded at deploy)
PAYLOAD_ADMIN_PASSWORD=            # First super-admin account password

# --- Astro Frontend (Issue #3) ---
PAYLOAD_API_URL=                   # Payload REST API base: e.g. http://localhost:3000/api
PAYLOAD_API_KEY=                   # Payload API key for Astro server-side fetches at build time
SITE_URL=                          # Public site URL: e.g. https://stoveguard.us.com

# --- Cloudflare Pages Hosting (Issue #3) ---
CLOUDFLARE_ACCOUNT_ID=             # Cloudflare dashboard > Account ID
CLOUDFLARE_API_TOKEN=              # API token with Pages deploy permissions
CLOUDFLARE_PROJECT_NAME=           # Pages project name: e.g. stoveguard
CLOUDFLARE_DEPLOY_HOOK_URL=        # Webhook URL — Payload afterChange hook triggers rebuild on publish

# --- Visitor Auth (Issue #12) ---
# OAuth (Google/Facebook) DROPPED 2026-05-14 — email-only signup/login with
# email verification. No OAuth credentials needed. Verification emails route
# through the Resend adapter below (Payload console transport in dev).
FRONTEND_URLS=http://localhost:4321   # CORS/CSRF allow-list; prod: https://stoveguard.us.com

# --- Resend Transactional Email (Issues #12, #15, #17) ---
# Used for: email verification (#12), review approval notifications (#15), newsletter digests (#17)
RESEND_API_KEY=                    # https://resend.com/api-keys
RESEND_FROM_EMAIL=                 # Verified sender: e.g. noreply@stoveguard.us.com
RESEND_REPLY_TO=                   # Optional: e.g. support@stoveguard.us.com

# --- Google Analytics 4 (Issue #11) ---
GA4_MEASUREMENT_ID=                # e.g. G-XXXXXXXXXX

# --- Google AdSense (Issue #19) ---
ADSENSE_PUBLISHER_ID=              # e.g. ca-pub-XXXXXXXXXXXXXXXX
ADSENSE_ENABLED=false              # Flip to true after AdSense approval. Until then, ad slots render empty gracefully.

# --- Social Auto-Posting (Issue #18) ---
# Optional — skip until Issue #18. Auto-posts to social when article is published via Payload hook.
TWITTER_API_KEY=                   # developer.x.com
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
FACEBOOK_PAGE_ACCESS_TOKEN=        # Graph API page token for auto-posting (different from OAuth app above)
PINTEREST_ACCESS_TOKEN=            # developers.pinterest.com

# --- Development ---
NODE_ENV=development               # development | production
PORT=3000                          # Payload CMS server port
ASTRO_PORT=4321                    # Astro dev server port
